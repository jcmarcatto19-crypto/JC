import discord
from discord.ext import commands
import random

intents = discord.Intents.default()
intents.message_content = True

bot = commands.Bot(command_prefix="!", intents=intents)

dicas = [
    "Economize água durante o banho.",
    "Desligue aparelhos eletrônicos quando não estiver usando.",
    "Use sacolas reutilizáveis.",
    "Evite produtos descartáveis."
]

desafios = [
    "Hoje, tente economizar água.",
    "Use transporte público ou bicicleta.",
    "Separe o lixo reciclável da sua casa.",
    "Evite usar plástico descartável hoje."
]

@bot.event
async def on_ready():
    print(f"Bot conectado como {bot.user}")

@bot.command()
async def dica(ctx):
    await ctx.send("🌱 Dica: " + random.choice(dicas))

@bot.command()
async def desafio(ctx):
    await ctx.send("♻️ Desafio: " + random.choice(desafios))

@bot.command()
async def reciclagem(ctx, material):
    materiais = {
        "papel": "Coloque na coleta de papel reciclável.",
        "plastico": "Coloque na coleta de plástico reciclável.",
        "vidro": "Coloque na coleta de vidro reciclável.",
        "metal": "Coloque na coleta de metais recicláveis."
    }

    resposta = materiais.get(
        material.lower(),
        "Não conheço esse material."
    )

    await ctx.send("♻️ " + resposta)

bot.run("CODE")
